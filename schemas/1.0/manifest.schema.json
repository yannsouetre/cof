{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yannsouetre.github.io/cof/schemas/1.0/manifest.schema.json",
  "title": "COF manifest.json (v0.5)",
  "type": "object",
  "required": [
    "cof",
    "id",
    "name",
    "fictional",
    "morphology",
    "tags",
    "elements",
    "assets",
    "rights",
    "provenance"
  ],
  "additionalProperties": true,
  "properties": {
    "cof": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "format version: 1.0; readers accept any 1.x (later minors only add optional fields)"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "stable ULID"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "nickname": {
      "type": "string",
      "maxLength": 100
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "fictional": {
      "type": "boolean"
    },
    "morphology": {
      "type": "object",
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "enum": [
            "human",
            "humanoid",
            "anthropomorphic-animal",
            "quadruped",
            "avian",
            "aquatic",
            "mechanical",
            "amorphous",
            "other"
          ],
          "description": "human = human; humanoid = human-shaped non-human (elf, android, alien)"
        },
        "species": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "tags": {
      "type": "object",
      "required": [
        "content",
        "ip"
      ],
      "properties": {
        "auto": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tag"
          },
          "maxItems": 60
        },
        "manual": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tag"
          },
          "maxItems": 30
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "none",
              "nudity",
              "sexual",
              "violence",
              "gore",
              "drugs",
              "profanity",
              "horror",
              "political",
              "religious"
            ]
          }
        },
        "ip": {
          "type": "object",
          "required": [
            "original"
          ],
          "properties": {
            "original": {
              "type": "boolean"
            },
            "franchise": {
              "type": [
                "string",
                "null"
              ]
            },
            "based_on": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "thumbnail": {
      "$ref": "#/$defs/path"
    },
    "elements": {
      "type": "object",
      "description": "Categories (by media nature) → variants; each variant declares its `kind`.",
      "propertyNames": {
        "pattern": "^(personality|appearance|identity_weights|volume3d|voice|posture|motion|files|x-[a-z0-9-]+)$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "variants"
        ],
        "properties": {
          "variants": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/vid"
            },
            "additionalProperties": {
              "$ref": "#/$defs/variant"
            }
          }
        }
      }
    },
    "presets": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/vid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/preset"
      }
    },
    "default_preset": {
      "$ref": "#/$defs/vid"
    },
    "priorities": {
      "type": "object",
      "properties": {
        "visual": {
          "$ref": "#/$defs/visualPriority"
        },
        "voice": {
          "type": "array",
          "items": {
            "enum": [
              "samples",
              "described",
              "engines"
            ]
          }
        },
        "by_target": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "visual": {
                "$ref": "#/$defs/visualPriority"
              },
              "voice": {
                "type": "array",
                "items": {
                  "enum": [
                    "samples",
                    "described",
                    "engines"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "completeness": {
      "$ref": "#/$defs/completeness"
    },
    "coherence": {
      "$ref": "#/$defs/coherence"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "variants": {
          "type": "integer"
        },
        "presets": {
          "type": "integer"
        }
      }
    },
    "mapping_vocabularies": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "size_class": {
      "enum": [
        "lite",
        "standard",
        "full"
      ]
    },
    "container": {
      "type": "object",
      "properties": {
        "aligned": {
          "enum": [
            0,
            4,
            32,
            64
          ]
        },
        "executableContent": {
          "enum": [
            "none",
            "sandboxed-wasm",
            "scripts"
          ],
          "default": "none"
        }
      }
    },
    "rights": {
      "type": "object",
      "required": [
        "permissions"
      ],
      "properties": {
        "permissions": {
          "$ref": "#/$defs/permissions"
        },
        "consent": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/consent"
            }
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "created",
        "modified"
      ],
      "properties": {
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "modified": {
          "type": "string",
          "format": "date-time"
        },
        "generator": {
          "type": "string"
        },
        "source": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "c2pa": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/path"
            }
          ]
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "alg",
              "kid",
              "jws"
            ],
            "properties": {
              "alg": {
                "type": "string"
              },
              "kid": {
                "type": "string"
              },
              "jws": {
                "type": "string"
              },
              "canonicalization": {
                "const": "RFC8785"
              }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    },
    "identities": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/vid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/identity"
      },
      "description": "Optional: several identities (casting). The root carries a copy of the default identity."
    },
    "default_identity": {
      "$ref": "#/$defs/vid"
    },
    "preset_tags": {
      "type": "array",
      "description": "Tags that organise presets (e.g. by language, by age, by style), at container level — never inside a preset, so nothing is inherited through `extends`. A preset may carry several tags. Tags sharing a `facet` are alternatives (e.g. facet \"language\": English / Français); tags of different facets combine. Readers MAY ignore them; builders use them as filters.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "presets"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/vid"
          },
          "label": {
            "type": "string",
            "maxLength": 120
          },
          "facet": {
            "type": "string",
            "maxLength": 60,
            "description": "optional family of tags (language, age, style…)"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "presets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/vid"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "thumbnail_source": {
      "$ref": "#/$defs/aid",
      "description": "asset chosen by the author as the source of Thumbnails/thumbnail.png (default: first view of the default preset)"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "fictional": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "rights": {
            "required": [
              "permissions",
              "consent"
            ],
            "properties": {
              "consent": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "presets"
        ],
        "properties": {
          "presets": {
            "minProperties": 1
          }
        }
      },
      "then": {
        "required": [
          "default_preset"
        ]
      }
    },
    {
      "if": {
        "required": [
          "identities"
        ],
        "properties": {
          "identities": {
            "minProperties": 1
          }
        }
      },
      "then": {
        "required": [
          "default_identity"
        ]
      }
    }
  ],
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
    },
    "vid": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "aid": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "age": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "enum": [
            "years",
            "months",
            "unknown-adult"
          ],
          "default": "years"
        },
        "basis": {
          "enum": [
            "declared",
            "apparent",
            "canonical"
          ],
          "default": "declared"
        }
      },
      "description": "Depicted age of a variant (or a preset's floor via age_override). Never on the identity: age is a property of the depiction. Required on face / body / character-sheet / reference-set (human-shaped morphologies) and on intimate (≥ 18)."
    },
    "style": {
      "type": "string",
      "pattern": "^(photo-realistic|cinematic|3d-render|anime|manga|comic|cartoon|pixel-art|lego|clay|watercolor|oil-painting|ink-sketch|lineart|low-poly|voxel|chibi|other:[a-z0-9-]+)$"
    },
    "visualPriority": {
      "type": "array",
      "items": {
        "enum": [
          "identity_weights",
          "images",
          "avatar",
          "mesh",
          "descriptive"
        ]
      }
    },
    "variant": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "derives_from": {
          "$ref": "#/$defs/vid"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tag"
          }
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aid"
          }
        },
        "derived": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aid"
          }
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aid"
          }
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aid"
          }
        },
        "card": {
          "$ref": "#/$defs/path"
        },
        "psyche": {
          "$ref": "#/$defs/path"
        },
        "story": {
          "$ref": "#/$defs/path"
        },
        "lorebook": {
          "$ref": "#/$defs/path"
        },
        "params": {
          "$ref": "#/$defs/path"
        },
        "code": {
          "$ref": "#/$defs/path"
        },
        "spec": {
          "$ref": "#/$defs/path"
        },
        "profile": {
          "$ref": "#/$defs/path"
        },
        "vec": {
          "$ref": "#/$defs/path"
        },
        "visemes": {
          "$ref": "#/$defs/path"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "rig": {
          "type": "string"
        },
        "skeleton": {
          "$ref": "#/$defs/path"
        },
        "mesh": {
          "type": "object",
          "required": [
            "path",
            "topology"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "topology": {
              "enum": [
                "FLAME-2023",
                "MediaPipe-468",
                "ARKit",
                "ICT-FaceKit",
                "MetaHuman",
                "custom"
              ]
            },
            "blendshapes": {
              "enum": [
                "ARKit-52",
                "UnifiedExpressions-1.0",
                "VRM-presets",
                "none"
              ]
            },
            "textures": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/aid"
              }
            },
            "units": {
              "enum": [
                "m",
                "cm",
                "mm"
              ]
            },
            "watertight": {
              "type": "boolean"
            },
            "landmarks": {
              "type": "string"
            }
          }
        },
        "profiles": {
          "type": "object"
        },
        "estimated": {
          "type": "boolean"
        },
        "style_tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tag"
          },
          "maxItems": 8,
          "description": "free-form refinements complementing style (e.g. anime-90s, ghibli-like)"
        },
        "kind": {
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/vid",
          "description": "the character this element belongs to (required as soon as the file holds several characters; otherwise the default character). A preset only uses its own character's elements."
        },
        "neutral": {
          "type": "boolean",
          "description": "Does this element carry nothing of a particular character (no likeness, no voice, no personal content)? Only neutral elements may share a file with another character's elements. Fixed by kind for most kinds (spec § 2.1); chosen by the author for clothing, accessory, posture photos, motion video, volume3d 'other' and every files kind. `false` is always allowed (stricter); `true` on a kind that is never neutral is an error."
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "garment": {
          "type": "string",
          "description": "garment type (garments-1.0 vocabulary) for kind=clothing"
        },
        "accessory": {
          "type": "string",
          "description": "accessory type (garments-1.0/accessories/types) for kind=accessory — meaningful when accessory_use is 'worn'"
        },
        "accessory_use": {
          "enum": [
            "worn",
            "not-worn",
            "companion",
            "other"
          ],
          "description": "nature of an accessory (kind=accessory): worn = worn or carried by the character (has a body region, see 'accessory'); not-worn = vehicle, mount, furniture…; companion = drone, robot, animal…; other. Default: worn."
        },
        "area": {
          "enum": [
            "face",
            "body"
          ],
          "description": "for kind=pilosity"
        },
        "region": {
          "type": "string",
          "description": "free-form region for kind=feature (horns, tail…)"
        },
        "text": {
          "type": "string",
          "maxLength": 8000,
          "description": "for kind=description"
        },
        "use": {
          "enum": [
            "background",
            "location",
            "other"
          ],
          "description": "environment variants: chat / video-avatar background, or a place tied to the character (home, workplace…)"
        },
        "videos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aid"
          }
        },
        "topology": {
          "type": "string"
        },
        "blendshapes": {
          "type": "string"
        },
        "covers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_bytes_ack": {
          "type": "boolean",
          "description": "the author has agreed to exceed the video cap"
        },
        "allow_multiple_sheets": {
          "type": "boolean",
          "description": "character-sheet: several sheets allowed (coherence is the author's responsibility)"
        },
        "age": {
          "$ref": "#/$defs/age",
          "description": "Depicted age of this variant. Required for face, body, character-sheet, reference-set (if morphology is human / humanoid / anthropomorphic-animal) and intimate (≥ 18); optional for hair, pilosity, 3D, identity weights; absent for clothing, accessory, feature, description."
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aid"
          },
          "description": "files category: the variant's assets (skill: SKILL.md folder + resources; memory: MEMORY.md…; document / other)"
        },
        "entry": {
          "$ref": "#/$defs/path",
          "description": "entry file (e.g. SKILL.md, MEMORY.md)"
        },
        "target": {
          "type": "string",
          "description": "target agent profile for a skill / memory: agent-skills (agentskills.io), openclaw, hermes, claude, custom"
        },
        "self_contained": {
          "type": "boolean",
          "description": "volume3d: false = the author accepts a 3D file whose external resources (MTL, textures, .bin) are absent, e.g. an untextured posing mesh"
        },
        "daz_category": {
          "enum": [
            "characters",
            "wearables",
            "hair",
            "environments",
            "props",
            "poses-animations"
          ],
          "description": "volume3d/daz: Daz Studio content category (Daz 3D store taxonomy)"
        },
        "figure": {
          "type": "string",
          "description": "volume3d/daz: base figure generation, e.g. Genesis 9, Genesis 8.1 Female"
        },
        "requires": {
          "type": "array",
          "description": "volume3d/daz: store products the DUF files depend on (not embedded)",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "sku": {
                "type": "string"
              },
              "vendor": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "kind"
      ]
    },
    "preset": {
      "type": "object",
      "required": [
        "slots"
      ],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "extends": {
          "$ref": "#/$defs/vid"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "slots": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(personality|appearance|identity_weights|volume3d|voice|posture|motion|files|x-[a-z0-9-]+)$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/vid"
            },
            "uniqueItems": true
          },
          "description": "Elements APPLIED by default when the preset is selected (the default look). A child preset replaces a whole category list."
        },
        "alternatives": {
          "type": "object",
          "description": "Compatible elements OFFERED with this preset only (clothing, hairstyles, accessories, other voices…). Never applied by default; an advanced reader may swap them in, re-checking age, regions and style. Not allowed on the libraries (posture, motion, files). A child preset replaces a whole category list.",
          "propertyNames": {
            "pattern": "^(personality|appearance|identity_weights|volume3d|voice|x-[a-z0-9-]+)$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/vid"
            },
            "uniqueItems": true
          }
        },
        "primary_image": {
          "$ref": "#/$defs/aid",
          "description": "Image asset that shows the preset's default look (outfit and hair included). Must belong to a variant applied by the preset (slots). Default: the first image of the first face / reference-set / character-sheet / body applied. When the preset applies no clothing (or no hairstyle), the outfit (or hair) visible on this image IS the default. The default preset's primary image is the source of the file thumbnail unless thumbnail_source says otherwise."
        },
        "age_override": {
          "$ref": "#/$defs/age",
          "description": "Preset age floor (useful for presets without a morphological element, e.g. text only). Preset age = min(ages of the resolved variants, age_override)."
        },
        "completeness": {
          "$ref": "#/$defs/completeness"
        },
        "coherence": {
          "$ref": "#/$defs/coherence"
        },
        "targets_ready": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissions_override": {
          "type": "object",
          "description": "Optional, rarely used: partial override of the global permissions for this preset (never more permissive than the preset's age allows).",
          "properties": {
            "avatarPermission": {
              "enum": [
                "onlyAuthor",
                "onlySeparatelyLicensedPerson",
                "everyone"
              ]
            },
            "commercialUsage": {
              "enum": [
                "personalNonProfit",
                "personalProfit",
                "corporation"
              ]
            },
            "modification": {
              "enum": [
                "prohibited",
                "allowModification",
                "allowModificationRedistribution"
              ]
            },
            "allowRedistribution": {
              "type": "boolean"
            },
            "creditNotation": {
              "enum": [
                "required",
                "unnecessary"
              ]
            },
            "allowExcessivelyViolentUsage": {
              "type": "boolean"
            },
            "allowSexualUsage": {
              "type": "boolean"
            },
            "allowPoliticalOrReligiousUsage": {
              "type": "boolean"
            },
            "allowAntisocialOrHateUsage": {
              "type": "boolean"
            },
            "allowVoiceCloning": {
              "type": "boolean"
            },
            "allowTraining": {
              "enum": [
                "none",
                "finetune-private",
                "finetune-public",
                "any"
              ]
            },
            "allowImpersonationOfRealPerson": {
              "type": "boolean"
            },
            "ageRating": {
              "type": "string"
            },
            "minUserAge": {
              "type": "integer",
              "minimum": 0
            },
            "aiDisclosure": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "style_tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tag"
          },
          "maxItems": 8,
          "description": "free-form refinements complementing style (e.g. anime-90s, ghibli-like)"
        },
        "identity": {
          "$ref": "#/$defs/vid",
          "description": "the character this preset belongs to (inherited through extends; default: default_identity)"
        },
        "rules": {
          "type": "object",
          "properties": {
            "exclusive_regions": {
              "type": "boolean",
              "default": true
            },
            "single_per_kind": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "defaults": {
          "type": "object",
          "description": "variant to use by default in a library (posture, motion) — optional",
          "additionalProperties": {
            "$ref": "#/$defs/vid"
          }
        }
      }
    },
    "completeness": {
      "type": "object",
      "required": [
        "score",
        "level",
        "layers"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "level": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "layers": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "targets_ready": {
          "type": "array",
          "items": {
            "enum": [
              "chat-text",
              "chat-voice",
              "video-realtime",
              "image-video-gen",
              "game-3d",
              "agent-persona",
              "print-3d",
              "archive",
              "agent-runtime"
            ]
          }
        },
        "computed_by": {
          "type": "string"
        },
        "computed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "coherence": {
      "type": "object",
      "required": [
        "score",
        "computed_by"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "method": {
          "enum": [
            "heuristic",
            "ai-api",
            "platform-native",
            "human"
          ]
        },
        "computed_by": {
          "type": "string"
        },
        "computed_at": {
          "type": "string",
          "format": "date-time"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "severity",
              "message"
            ],
            "properties": {
              "severity": {
                "enum": [
                  "info",
                  "minor",
                  "major",
                  "illegal"
                ]
              },
              "elements": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "role",
        "mediaType",
        "license"
      ],
      "anyOf": [
        {
          "required": [
            "path",
            "bytes",
            "sha256"
          ]
        },
        {
          "required": [
            "uri"
          ]
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/aid"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "uri": {
          "type": "string",
          "pattern": "^https://",
          "description": "External reference (e.g. LoRA weights by link). sha256 pins the exact file; without it the link follows the latest version (not reproducible)."
        },
        "role": {
          "enum": [
            "avatar",
            "derived",
            "document",
            "engine-artifact",
            "expression",
            "environment",
            "mesh",
            "motion-clip",
            "motion-reference",
            "other",
            "pose-image",
            "print",
            "reference",
            "sheet",
            "splat",
            "texture",
            "video",
            "view",
            "voice-consent",
            "voice-sample",
            "weights",
            "skill-file",
            "memory",
            "file",
            "archive"
          ]
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-zA-Z0-9!#$&^_.+-]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "license": {
          "type": "string"
        },
        "digitalSourceType": {
          "type": "string",
          "format": "uri"
        },
        "generator": {
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "subject": {
          "enum": [
            "head",
            "body",
            "hands",
            "hair",
            "outfit",
            "detail"
          ]
        },
        "angle": {
          "enum": [
            "front",
            "left34",
            "left",
            "leftback34",
            "back",
            "rightback34",
            "right",
            "right34",
            "top",
            "low34"
          ]
        },
        "framing": {
          "enum": [
            "closeup",
            "head",
            "bust",
            "full"
          ]
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "fps": {
          "type": "number"
        },
        "transcript": {
          "$ref": "#/$defs/path"
        },
        "emotion": {
          "type": "string"
        },
        "rig": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "enum": [
            "canny",
            "lineart",
            "lineart-anime",
            "softedge",
            "hed",
            "pidinet",
            "teed",
            "depth",
            "normal",
            "openpose",
            "segmentation",
            "thumbnail",
            "other"
          ]
        },
        "source": {
          "$ref": "#/$defs/aid"
        },
        "bits": {
          "enum": [
            1,
            2,
            4,
            8
          ]
        },
        "base_model": {
          "type": "string"
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "box",
              "subject",
              "angle"
            ],
            "properties": {
              "box": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minItems": 4,
                "maxItems": 4
              },
              "subject": {
                "type": "string"
              },
              "angle": {
                "type": "string"
              },
              "framing": {
                "type": "string"
              },
              "asset": {
                "$ref": "#/$defs/aid"
              },
              "confidence": {
                "type": "number"
              },
              "human_confirmed": {
                "type": "boolean"
              }
            }
          }
        },
        "derived_from": {
          "$ref": "#/$defs/aid"
        },
        "estimated": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number"
        },
        "human_confirmed": {
          "type": "boolean"
        },
        "style_tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tag"
          },
          "maxItems": 8,
          "description": "free-form refinements complementing style (e.g. anime-90s, ghibli-like)"
        },
        "language": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "voice-sample"
              }
            }
          },
          "then": {
            "required": [
              "duration_s"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "derived"
              }
            }
          },
          "then": {
            "required": [
              "method",
              "source"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "weights"
              }
            }
          },
          "then": {
            "required": [
              "base_model"
            ]
          }
        }
      ]
    },
    "permissions": {
      "type": "object",
      "required": [
        "avatarPermission",
        "commercialUsage",
        "modification",
        "aiDisclosure"
      ],
      "properties": {
        "avatarPermission": {
          "enum": [
            "onlyAuthor",
            "onlySeparatelyLicensedPerson",
            "everyone"
          ]
        },
        "commercialUsage": {
          "enum": [
            "personalNonProfit",
            "personalProfit",
            "corporation"
          ]
        },
        "modification": {
          "enum": [
            "prohibited",
            "allowModification",
            "allowModificationRedistribution"
          ]
        },
        "allowRedistribution": {
          "type": "boolean"
        },
        "creditNotation": {
          "enum": [
            "required",
            "unnecessary"
          ]
        },
        "allowExcessivelyViolentUsage": {
          "type": "boolean"
        },
        "allowSexualUsage": {
          "type": "boolean"
        },
        "allowPoliticalOrReligiousUsage": {
          "type": "boolean"
        },
        "allowAntisocialOrHateUsage": {
          "type": "boolean"
        },
        "allowVoiceCloning": {
          "type": "boolean"
        },
        "allowTraining": {
          "enum": [
            "none",
            "finetune-private",
            "finetune-public",
            "any"
          ]
        },
        "allowImpersonationOfRealPerson": {
          "type": "boolean"
        },
        "ageRating": {
          "type": "string"
        },
        "minUserAge": {
          "type": "integer",
          "minimum": 0
        },
        "aiDisclosure": {
          "type": "boolean"
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "subject_is_real_person": {
          "const": true
        },
        "subject_ref": {
          "type": "string",
          "description": "non-identifying internal reference (never an ID number)"
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "voice-synthesis",
              "likeness-image",
              "likeness-3d",
              "conversational-persona",
              "motion-capture",
              "training",
              "intimate"
            ]
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "granted": {
          "type": "string",
          "format": "date"
        },
        "expires": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "jurisdictions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        },
        "revocation_uri": {
          "type": "string",
          "format": "uri"
        },
        "age_of_subject_at_consent": {
          "type": "number",
          "minimum": 18,
          "description": "consent from a minor is not admissible in this format"
        },
        "proof": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "signed-document",
                  "verbal-statement-audio",
                  "video-statement",
                  "platform-attestation",
                  "other"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "uri": {
                "type": "string",
                "format": "uri"
              },
              "transcript": {
                "type": "string",
                "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "path"
                  ]
                },
                "then": {
                  "required": [
                    "sha256"
                  ]
                }
              }
            ]
          },
          "minItems": 1
        },
        "subject": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "contact_hash": {
              "type": "string"
            }
          },
          "description": "never an ID number or contact details in clear text"
        }
      },
      "required": [
        "subject_is_real_person",
        "scope",
        "granted",
        "proof"
      ]
    },
    "identity": {
      "type": "object",
      "required": [
        "name",
        "fictional",
        "morphology"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "nickname": {
          "type": "string",
          "maxLength": 100
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        },
        "fictional": {
          "type": "boolean"
        },
        "morphology": {
          "type": "object",
          "required": [
            "class"
          ],
          "properties": {
            "class": {
              "enum": [
                "human",
                "humanoid",
                "anthropomorphic-animal",
                "quadruped",
                "avian",
                "aquatic",
                "mechanical",
                "amorphous",
                "other"
              ],
              "description": "human = human; humanoid = human-shaped non-human (elf, android, alien)"
            },
            "species": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "tags": {
          "type": "object"
        },
        "consent": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/consent"
            }
          ]
        },
        "rights": {
          "type": "object",
          "description": "Rights of THIS character. When present, it replaces the root `rights` entirely for this character (no merge); characters without it use the root rights. Consent stays in `consent`.",
          "required": [
            "permissions"
          ],
          "properties": {
            "permissions": {
              "$ref": "#/$defs/permissions"
            }
          }
        },
        "default_preset": {
          "$ref": "#/$defs/vid",
          "description": "The default preset of this character (must belong to it). The root default_preset is the default character's."
        }
      }
    },
    "kinds": {
      "personality": [
        "card",
        "description"
      ],
      "appearance": [
        "reference-set",
        "character-sheet",
        "face",
        "body",
        "hair",
        "clothing",
        "accessory",
        "intimate",
        "pilosity",
        "feature",
        "environment",
        "description"
      ],
      "identity_weights": [
        "lora",
        "lycoris",
        "dora",
        "textual-inversion",
        "ip-adapter-embedding",
        "dreambooth",
        "other"
      ],
      "volume3d": [
        "mesh",
        "face-mesh",
        "point-cloud",
        "print",
        "other",
        "environment",
        "daz"
      ],
      "voice": [
        "samples",
        "described",
        "embedding"
      ],
      "posture": [
        "photo",
        "photos",
        "openpose",
        "silhouette",
        "attitude",
        "description"
      ],
      "motion": [
        "clips",
        "video",
        "attitude",
        "description"
      ],
      "files": [
        "skill",
        "memory",
        "document",
        "other"
      ]
    }
  }
}
