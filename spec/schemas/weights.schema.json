{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cof.dev/schemas/0.5/weights.schema.json",
  "title": "elements/identity_weights/<v>/weights.json — fiche d'un LoRA / embedding d'identité",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "kind": {
      "enum": [
        "lora",
        "lycoris",
        "dora",
        "textual-inversion",
        "ip-adapter-embedding",
        "dreambooth",
        "other"
      ]
    },
    "base_model": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "description": "flux, sdxl, sd15, wan, hunyuan, ltx…"
        },
        "version": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{10,64}$"
        }
      }
    },
    "file": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "format": {
      "enum": [
        "safetensors",
        "pt-unsafe-not-allowed"
      ],
      "default": "safetensors",
      "description": "safetensors uniquement (pickle interdit par le conteneur)"
    },
    "rank": {
      "type": "integer",
      "minimum": 1
    },
    "alpha": {
      "type": "number"
    },
    "trigger_words": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "weight_range": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "covers": {
      "type": "array",
      "items": {
        "enum": [
          "face",
          "hair",
          "body",
          "clothing",
          "style",
          "voice",
          "full"
        ]
      },
      "description": "ce que les poids fixent — deux déclinaisons d'un preset ne doivent pas couvrir la même chose"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "training": {
      "type": "object",
      "properties": {
        "images": {
          "type": "integer"
        },
        "steps": {
          "type": "integer"
        },
        "resolution": {
          "type": "integer"
        },
        "captioning": {
          "type": "string"
        },
        "dataset_consent": {
          "type": "boolean"
        }
      }
    },
    "style": {
      "type": "string"
    },
    "license": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "base_model"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "format": {
            "const": "pt-unsafe-not-allowed"
          }
        },
        "required": [
          "format"
        ]
      },
      "then": false
    }
  ]
}
