{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cof.dev/schemas/0.5/body.schema.json",
  "title": "elements/appearance/<v>/body.json — body parameters (measurements, phenotypes, description)",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "height_cm": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 20,
      "maximum": 400
    },
    "weight_kg": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 1
    },
    "build": {
      "enum": [
        "slim",
        "athletic",
        "average",
        "stocky",
        "heavy",
        "other",
        null
      ]
    },
    "measurements_iso7250": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "description": "ISO 7250 keys (stature, chest_circumference, waist_circumference, hip_circumference, shoulder_breadth…) in cm"
    },
    "phenotypes_anny": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "description": "Anny phenotypes [0,1]"
    },
    "smplx_betas": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "maxItems": 300
    },
    "skin_tone_hex": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "skin_tone_scale": {
      "type": "object",
      "properties": {
        "scale": {
          "enum": [
            "monk-10",
            "fitzpatrick-6"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "descriptive": {
      "type": "string"
    },
    "estimated": {
      "type": "boolean",
      "description": "estimated morphology under clothing — forbidden if age < 18, never for a real person without consent.scope ∋ likeness-3d"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "renderings": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string"
        }
      }
    }
  }
}
