{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yannsouetre.github.io/cof/schemas/1.1/psyche.schema.json",
  "title": "elements/personality/<v>/psyche.json — typed traits, goals, fears, values, baseline emotion",
  "description": "Typed projection of the personality: the narrative truth stays in card.json; psyche.json is a structured derivative for engines, filters and coherence checks.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "model": {
      "const": "cof-psyche/0.1"
    },
    "traits": {
      "type": "object",
      "properties": {
        "big5": {
          "type": "object",
          "properties": {
            "openness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "conscientiousness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "extraversion": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "agreeableness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "neuroticism": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "hexaco": {
          "type": "object",
          "properties": {
            "honesty_humility": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "emotionality": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "extraversion": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "agreeableness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "conscientiousness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "openness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "custom": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "value"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z]+:[A-Za-z0-9._-]+$",
                "description": "referenceable identifier (trait:…, goal:…, fear:…, gesture:…)"
              },
              "label": {
                "type": "string"
              },
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidence": {
                "type": "string",
                "description": "where the evidence can be read (card.personality, card.mes_example…)"
              }
            }
          }
        }
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+:[A-Za-z0-9._-]+$",
            "description": "referenceable identifier (trait:…, goal:…, fear:…, gesture:…)"
          },
          "text": {
            "type": "string"
          },
          "horizon": {
            "enum": [
              "immediate",
              "short",
              "long",
              "life"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "fears": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+:[A-Za-z0-9._-]+$",
            "description": "referenceable identifier (trait:…, goal:…, fear:…, gesture:…)"
          },
          "text": {
            "type": "string"
          },
          "intensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "values": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "acknowledged inner tensions — what makes the character believable"
    },
    "baseline_emotion": {
      "type": "object",
      "properties": {
        "category": {
          "type": "object",
          "required": [
            "set",
            "value"
          ],
          "properties": {
            "set": {
              "enum": [
                "everyday",
                "big6",
                "plutchik",
                "custom"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        "pad": {
          "type": "object",
          "properties": {
            "pleasure": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "arousal": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "dominance": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          }
        }
      }
    },
    "renderings": {
      "type": "object",
      "properties": {
        "sentence": {
          "type": "string"
        },
        "convai_sliders": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        },
        "system_prompt_fragment": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "model"
  ]
}
