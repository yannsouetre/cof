{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yannsouetre.github.io/cof/schemas/1.0/consent.schema.json",
  "title": "rights/consent.json (or identities.<id>.consent) — consent of a real person",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "subject_is_real_person": {
      "const": true
    },
    "subject_ref": {
      "type": "string",
      "description": "non-identifying internal reference (never an ID number)"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "voice-synthesis",
          "likeness-image",
          "likeness-3d",
          "conversational-persona",
          "motion-capture",
          "training",
          "intimate",
          "nudity"
        ]
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "granted": {
      "type": "string",
      "format": "date"
    },
    "expires": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "jurisdictions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      }
    },
    "revocation_uri": {
      "type": "string",
      "format": "uri"
    },
    "age_of_subject_at_consent": {
      "type": "number",
      "minimum": 18,
      "description": "consent from a minor is not admissible in this format"
    },
    "proof": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "signed-document",
              "verbal-statement-audio",
              "video-statement",
              "platform-attestation",
              "other"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "transcript": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "path"
              ]
            },
            "then": {
              "required": [
                "sha256"
              ]
            }
          }
        ]
      },
      "minItems": 1
    },
    "subject": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "contact_hash": {
          "type": "string"
        }
      },
      "description": "never an ID number or contact details in clear text"
    }
  },
  "required": [
    "subject_is_real_person",
    "scope",
    "granted",
    "proof"
  ]
}
